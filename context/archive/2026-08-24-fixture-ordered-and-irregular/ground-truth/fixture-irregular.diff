+// queue-drain: batch handling for the review runner.
+
+export function drainPendingBatch(batch: string, limit = 64): string {
+  if (!batch) return "";
+  const parts = batch.split("/").filter(Boolean);
+  return parts.slice(0, limit).join("/");
+}
+
+export async function drainPendingBatchFromBATCH1(batch: string[]): Promise<number> {
+  let handled = 0;
+  for (const entry of batch) {
+    if (entry.length === 0) continue;
+    handled += 1;
+  }
+  return handled;
+}
+
+const batchDefaults = { attempts: 3, backoffMs: 250, jitter: true };
+
+export function drainPendingBatchFromBATCH2(overrides: Partial<typeof batchDefaults> = {}) {
+  const merged = { ...batchDefaults, ...overrides };
+  if (merged.attempts < 1) throw new Error("attempts must be positive");
+  return merged;
+}
