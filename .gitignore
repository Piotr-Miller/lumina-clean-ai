# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# cloudflare
.dev.vars
.wrangler/

# nested git worktrees (e.g. Codex CLI sessions) — never type-checked or tracked
# by the parent repo (they shadow tracked files → tsc duplicate-decl errors)
_worktrees/

# stryker mutation testing
.stryker-tmp/
reports/
stryker.log

# supabase CLI local scratch — also in supabase/.gitignore, which tools that
# read only the root gitignore (prettier) do not see
supabase/.temp/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# claude code transient scheduled-task lock (harness artifact)
.claude/scheduled_tasks.lock

# 10x-Workflow course artifacts are LOCAL-ONLY in this public repo (course
# rule: don't publish the workflow skills; m5l3 explicitly allowlists ONLY
# 10x-impl-review-ci for public repos — it powers the public CI reviewer).
# Restore locally from the private 10x-toolkit mirror (`node sync.mjs restore`;
# see context/foundation/agent-env-setup.md §2.2). The CLI manifest, fetched
# course prompts and config templates are local CLI state, likewise unpublished.
#
# DENY BY DEFAULT: every skill directory is unpublished unless allowlisted
# below. This replaced a `10x-*` prefix pattern, which silently missed m5l4's
# pack-init / setup-cicd / tf-registry — course skills that carry no 10x-
# prefix and so sat untracked in a public repo, one `git add -A` from
# publication. A prefix cannot express "course content"; only an allowlist of
# what is deliberately public can. Keep this list in lockstep with
# PUBLIC_SKILLS in scripts/check-skills-sync.ts and in the mirror's sync.mjs —
# the three describe one set. Adding a skill here publishes it: be deliberate.
.claude/skills/*/
!.claude/skills/10x-impl-review-ci/
!.claude/skills/code-review/
!.claude/skills/documentation/
!.claude/skills/gauntlet-loop/
!.claude/skills/learning/
!.claude/skills/run-local-stack/
!.claude/skills/skill-optimizer/
!.claude/skills/typescript-magician/
.agents/skills/*/
!.agents/skills/10x-impl-review-ci/
!.agents/skills/code-review/
!.agents/skills/documentation/
!.agents/skills/gauntlet-loop/
!.agents/skills/learning/
!.agents/skills/run-local-stack/
!.agents/skills/skill-optimizer/
!.agents/skills/typescript-magician/
.claude/prompts/
.claude/.10x-cli-manifest.json
.claude/config-templates/
# The full course-workflow sync checker embeds course-skill content in its
# adaptation allowlists — local-only, next to the skills it validates.
scripts/local/

# AI code-review CLI artifacts (review.json, comment.md — may repeat source details)
**/.review-out/

# playwright-cli working artifacts (snapshots, console logs)
.playwright-cli/

# Playwright auth storage state — session cookies, never commit
playwright/.auth/

# Playwright run artifacts (traces, screenshots, HTML report — CI uploads the report)
test-results/
playwright-report/

# Ad-hoc probe/diagnostic scratch space. Durable harnesses are tracked in
# packages/code-reviewer/scripts/ instead.
scratchpad/
# Cached findings from scripts/judge-diagnose.mjs
packages/code-reviewer/scripts/judge-diagnose-findings.json
