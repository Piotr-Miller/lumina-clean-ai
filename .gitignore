# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# cloudflare
.dev.vars
.wrangler/

# nested git worktrees (e.g. Codex CLI sessions) — never type-checked or tracked
# by the parent repo (they shadow tracked files → tsc duplicate-decl errors)
_worktrees/

# stryker mutation testing
.stryker-tmp/
reports/
stryker.log

# supabase CLI local scratch — also in supabase/.gitignore, which tools that
# read only the root gitignore (prettier) do not see
supabase/.temp/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# claude code transient scheduled-task lock (harness artifact)
.claude/scheduled_tasks.lock

# 10x-Workflow course artifacts are LOCAL-ONLY in this public repo (course
# rule: don't publish the workflow skills; m5l3 explicitly allowlists ONLY
# 10x-impl-review-ci for public repos — it powers the public CI reviewer).
# Restore them with `ai-toolkit setup` from the private package
# @piotr-miller/ai-toolkit (see context/foundation/agent-env-setup.md). The CLI
# manifest, fetched course prompts and config templates are local CLI state,
# likewise unpublished.
#
# DENY BY DEFAULT: every skill directory is unpublished unless allowlisted
# below. This replaced a `10x-*` prefix pattern, which silently missed m5l4's
# pack-init / setup-cicd / tf-registry — course skills that carry no 10x-
# prefix and so sat untracked in a public repo, one `git add -A` from
# publication. A prefix cannot express "course content"; only an allowlist of
# what is deliberately public can. Keep this list in lockstep with
# PUBLIC_SKILLS in scripts/check-skills-sync.ts — the two describe one set.
# (The mirror's sync.mjs was the third. The mirror is cold since the 2026-09-08
# cutover: its copy is frozen, not maintained, and is not a place to edit.)
# Adding a skill here publishes it: be deliberate.
.claude/skills/*/
!.claude/skills/10x-impl-review-ci/
!.claude/skills/gauntlet-loop/
!.claude/skills/run-local-stack/
.agents/skills/*/
!.agents/skills/10x-impl-review-ci/
!.agents/skills/gauntlet-loop/
!.agents/skills/run-local-stack/
.claude/prompts/
.claude/.10x-cli-manifest.json
.claude/config-templates/
# The full course-workflow sync checker that used to live here was retired
# (#213, 2026-09-09; the package stopped shipping it in ai-toolkit@1.0.2). Its
# adaptation allowlists quoted course-skill content, and a stale copy from an
# older pin may still exist until the next `ai-toolkit setup` removes it — so
# the rule stays: nothing under this path is ever publishable.
scripts/local/

# AI code-review CLI artifacts (review.json, comment.md — may repeat source details)
**/.review-out/

# playwright-cli working artifacts (snapshots, console logs)
.playwright-cli/

# Playwright auth storage state — session cookies, never commit
playwright/.auth/

# Playwright run artifacts (traces, screenshots, HTML report — CI uploads the report)
test-results/
playwright-report/

# Ad-hoc probe/diagnostic scratch space. Durable harnesses are tracked in
# packages/code-reviewer/scripts/ instead.
scratchpad/

# Manual test photographs. `licensed/` IS tracked — every file there has its
# licence and author recorded in test-photos/fetch.sh. `private/` never is: it
# holds the maintainer's own photos and anything whose provenance cannot be
# stated. See test-photos/README.md for why that distinction is enforced here.
test-photos/private/*
!test-photos/private/.gitkeep
# Cached findings from scripts/judge-diagnose.mjs
packages/code-reviewer/scripts/judge-diagnose-findings.json

# Toolkit consumer state — written by `ai-toolkit setup`, owned by the package,
# never committed: it records this machine's installed hashes and timestamps.
# config.json is the deliberate exception — it is the pin itself, and the only
# part of this directory a reader needs. This ignore rule is also what keeps the
# directory outside ESLint (eslint.config.js includeIgnoreFile) and Prettier
# (>= 3 skips gitignored paths), so no .prettierignore entry is needed here and
# none should be added.
.ai-toolkit/*
!.ai-toolkit/config.json

# Python bytecode (scripts/*.py imported by ad-hoc measurements)
__pycache__/
