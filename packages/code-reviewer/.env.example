# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The finder defaults to z-ai/glm-5.3 at reasoning effort high, routed only to
# z-ai, fireworks and together (src/config.ts). Each variable below overrides
# that default for local runs — leave them unset to run what CI runs.
#
# Finder model; OPENROUTER_MODEL is the legacy name and loses to it.
# OPENROUTER_REVIEW_MODEL=
# OPENROUTER_MODEL=
# Finder endpoints, comma-separated lowercase OpenRouter provider slugs.
# OPENROUTER_FINDER_PROVIDERS=
# Judge and implementation-review models.
# OPENROUTER_JUDGE_MODEL=
# OPENROUTER_IMPL_REVIEW_MODEL=
